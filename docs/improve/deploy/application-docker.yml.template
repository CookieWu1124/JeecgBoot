# =============================================================================
# 公司 DEV · 后端外部配置覆盖模板
# -----------------------------------------------------------------------------
# 用法：
#   1. 复制本文件到服务器：/opt/spex-dev/config/application-docker.yml
#   2. 把下方所有 <<...>> 占位符换成真实值（勿提交含真实密码的副本进 Git）
#   3. docker-compose 需挂载：./config:/jeecg-boot/config
#   4. 打包使用 -Pdocker，使 spring.profiles.active=docker，才会合并本文件
#
# 说明：本文件只覆盖「发版必改」项；其余沿用 jar 内 application-docker.yml。
# 手册：docs/improve/公司DEV环境-后端Docker部署手册.md
# =============================================================================

spring:
  flyway:
    # 提案库靠手工 SQL；务必关闭
    enabled: false
    clean-disabled: true

  datasource:
    dynamic:
      datasource:
        master:
          # 把运维给的连接串贴到 url（建议带上下面查询参数；若连接串已含参数可整段替换）
          # 示例形态：jdbc:mysql://10.x.x.x:3306/inside_dev?characterEncoding=UTF-8&useUnicode=true&useSSL=false&tinyInt1isBit=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
          url: <<JDBC_URL>>
          username: <<DB_USER>>
          password: <<DB_PASSWORD>>
          driver-class-name: com.mysql.cj.jdbc.Driver

  data:
    redis:
      database: 0
      # 与 Compose 内 Redis 服务名一致（同一 docker network）
      host: jeecg-boot-redis
      port: 6379
      # Redis 无密码则保持空；有密码则填写并与 redis-server --requirepass 一致
      password: <<REDIS_PASSWORD_OR_EMPTY>>

jeecg:
  uploadType: local
  path:
    # 须与 Compose volume 容器侧路径一致，例如：./upFiles:/jeecg-boot/upFiles
    upload: /jeecg-boot/upFiles
    webapp: /jeecg-boot/webapp
  domainUrl:
    # 管理端 / 小程序实际访问入口（给链接拼装用；前端 baseURL 另配）
    pc: http://<<APP_HOST_OR_DOMAIN>>:3100
    app: http://<<APP_HOST_OR_DOMAIN>>:8080
  # 微信小程序（后端专用；与公众平台该环境 AppID 一致）
  wx-mini:
    app-id: <<WX_MINI_APP_ID>>
    app-secret: '<<WX_MINI_APP_SECRET>>'
  # 分布式锁走同一 Redis
  redisson:
    address: jeecg-boot-redis:6379
    password: <<REDIS_PASSWORD_OR_EMPTY>>
    type: STANDALONE
    enabled: true

# DEV 可开 Knife4j；对公网暴露时建议改为 production: true 或加 basic
knife4j:
  enable: true
  production: false
