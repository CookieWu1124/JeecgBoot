# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'development'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = false
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = true

# spex-inside 本地 JeecgBoot（application-dev.yml: port 8080, context-path /jeecg-boot）
VITE_SERVER_BASEURL = 'http://127.0.0.1:8080/jeecg-boot'

# H5 走 Vite 代理，避免浏览器跨域（前缀见 env/.env 的 VITE_APP_PROXY_PREFIX）
VITE_APP_PROXY_ENABLE = true

# 微信开发者工具联调（勾选「不校验合法域名」）
VITE_SERVER_BASEURL__WEIXIN_DEVELOP = 'http://127.0.0.1:8080/jeecg-boot'
VITE_SERVER_BASEURL__WEIXIN_TRIAL = ''
VITE_SERVER_BASEURL__WEIXIN_RELEASE = ''
